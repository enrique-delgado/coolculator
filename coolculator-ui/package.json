{
  "name": "coolculator-ui",
  "version": "0.1.0",
  "description": "React + TypeScript frontend for coolculator",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
