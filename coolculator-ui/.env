# The single place the frontend's API base URL is defined — every API call
# reads it through src/config/env.ts, nothing else references this directly.
# Local dev default: coolculator-backend run directly (go run ./cmd/api).
VITE_API_BASE_URL=http://localhost:8080

# About panel — author attribution and repository link, shown as-is (not
# translated, since a name/email/URL means the same thing in every locale).
VITE_AUTHOR_NAME=Enrique Delgado
VITE_AUTHOR_EMAIL=kikedelgado007@gmail.com
VITE_GITHUB_URL=https://github.com/enrique-delgado/coolculator
