{
  "info": {
    "_postman_id": "b1e2c3d4-5f6a-4b7c-8d9e-0a1b2c3d4e5f",
    "name": "coolculator API",
    "description": "REST API for coolculator's backend (coolculator-backend). Every request uses {{apiBaseUrl}}, defined once per environment — see the three bundled environments (local, docker, render). See ../docs/03-api-contract.md for the full written contract.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('response carries an X-Request-Id header', function () {",
          "    pm.response.to.have.header('X-Request-Id');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health & Info",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/health",
              "host": ["{{apiBaseUrl}}"],
              "path": ["health"]
            },
            "description": "Liveness probe. Also what the integration test suite and Docker's HEALTHCHECK use to confirm the service is up."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('body reports ok', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{apiBaseUrl}}/info",
              "host": ["{{apiBaseUrl}}"],
              "path": ["info"]
            },
            "description": "Build/version metadata — the same endpoint the frontend's About panel calls."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('body has version, commit, and builtAt', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body).to.have.property('version');",
                  "    pm.expect(body).to.have.property('commit');",
                  "    pm.expect(body).to.have.property('builtAt');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Calculate",
      "item": [
        {
          "name": "Add",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"add\",\n  \"operand1\": 2,\n  \"operand2\": 3\n}"
            },
            "url": {
              "raw": "{{apiBaseUrl}}/api/v1/calculate",
              "host": ["{{apiBaseUrl}}"],
              "path": ["api", "v1", "calculate"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('result is 5', function () {",
                  "    pm.expect(pm.response.json().result).to.eql(5);",
                  "});",
                  "",
                  "pm.test('response does not echo the request', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body).to.not.have.property('operation');",
                  "    pm.expect(body).to.not.have.property('operand1');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
