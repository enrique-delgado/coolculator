        {
          "name": "Explicit Zero Operand",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"add\",\n  \"operand1\": 0,\n  \"operand2\": 5\n}"
            },
            "url": {
              "raw": "{{apiBaseUrl}}/api/v1/calculate",
              "host": ["{{apiBaseUrl}}"],
              "path": ["api", "v1", "calculate"]
            },
            "description": "Regression check for docs/00-decisions.md D11: operand1 is a legitimate 0, not a missing value, and must be accepted."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200 (0 is not treated as missing)', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('result is 5', function () {",
                  "    pm.expect(pm.response.json().result).to.eql(5);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
